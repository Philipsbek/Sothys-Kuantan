---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { appointmentHrefZh } from '../../../data/catalog.zh';
import { zhBlogCategories, zhBlogPosts } from '../../../data/blog.zh';
const featuredPosts=zhBlogPosts.slice(0,3);
const itemListSchema={ '@context':'https://schema.org','@type':'CollectionPage',name:'Sothys Kuantan 中文护肤专栏',description:'为关丹与马来西亚读者准备的专业面部护理与日常护肤指南。',url:new URL('/zh/blog',Astro.site??Astro.url.origin).href,mainEntity:{'@type':'ItemList',itemListElement:zhBlogPosts.map((post,index)=>({'@type':'ListItem',position:index+1,name:post.title,url:new URL(`/zh/blog/${post.slug}`,Astro.site??Astro.url.origin).href}))}};
---
<BaseLayout lang="zh" title="关丹护肤与面部护理专栏" description="阅读30篇为关丹热带气候与本地护肤需要而写的中文专业护理和日常护肤指南。" canonicalPath="/zh/blog" image={featuredPosts[0].image} schema={itemListSchema}>
  <section class="blog-index-hero shell"><p class="eyebrow">Sothys Kuantan 护肤专栏</p><h1 class="display-sm">更好的肌肤，<br />从正确知识开始。</h1><div class="blog-index-intro"><p>为关丹炎热潮湿的气候而写，分享专业面部护理、居家保养与日常习惯的实用中文指南。</p><span>{zhBlogPosts.length} 篇原创指南</span></div></section>
  <section class="blog-featured shell" aria-labelledby="zh-featured-heading"><div class="blog-section-heading"><p class="eyebrow">从这里开始</p><h2 id="zh-featured-heading">精选指南。</h2></div><div class="blog-featured-grid">{featuredPosts.map((post,index)=><a class:list={['blog-featured-card',{'blog-featured-card--lead':index===0}]} href={`/zh/blog/${post.slug}`}><img src={post.image} alt={post.imageAlt} width="1400" height="900" loading={index===0?'eager':'lazy'} decoding="async"/><div><p><span>{post.category}</span><span>{String(index+1).padStart(2,'0')}</span></p><h3>{post.title}</h3><span class="blog-card-link">阅读指南</span></div></a>)}</div></section>
  <section class="blog-library shell" aria-labelledby="zh-library-heading" data-blog-library><div class="blog-library-top"><div class="blog-section-heading"><p class="eyebrow">浏览专栏</p><h2 id="zh-library-heading">30种更聪明的护肤方式。</h2></div><div class="blog-filters" aria-label="筛选指南">{zhBlogCategories.map((category,index)=><button class:list={{'is-active':index===0}} type="button" data-blog-filter={category} aria-pressed={index===0?'true':'false'}>{category}</button>)}</div></div><div class="blog-grid" data-blog-grid>{zhBlogPosts.map((post,index)=><article class="blog-card" data-blog-card data-category={post.category}><a href={`/zh/blog/${post.slug}`} aria-label={`阅读${post.title}`}><div class="blog-card-image"><img src={post.image} alt={post.imageAlt} width="1400" height="900" loading={index<6?'eager':'lazy'} decoding="async"/></div><div class="blog-card-copy"><p class="blog-card-meta"><span>{post.category}</span><span>{String(index+1).padStart(2,'0')}</span></p><h3>{post.title}</h3><p>{post.excerpt}</p><span class="blog-card-link">阅读指南</span></div></a></article>)}</div><p class="blog-empty" data-blog-empty hidden>这个类别暂时没有指南。</p></section>
  <section class="consultation-band shell blog-consultation"><div><p class="eyebrow">需要个人建议？</p><h2>把阅读变成适合你的肌肤计划。</h2></div><div><p>告诉关丹团队你的肌肤状况，我们会协助你选择合适的咨询与专业护理方向。</p><a class="pill" href={appointmentHrefZh} target="_blank" rel="noopener noreferrer">WhatsApp 咨询</a></div></section>
  <script>
    const library=document.querySelector<HTMLElement>('[data-blog-library]');const filters=Array.from(library?.querySelectorAll<HTMLButtonElement>('[data-blog-filter]')??[]);const cards=Array.from(library?.querySelectorAll<HTMLElement>('[data-blog-card]')??[]);const empty=library?.querySelector<HTMLElement>('[data-blog-empty]');filters.forEach((filter)=>filter.addEventListener('click',()=>{const selected=filter.dataset.blogFilter??'全部';filters.forEach((button)=>{const active=button===filter;button.classList.toggle('is-active',active);button.setAttribute('aria-pressed',String(active));});let visible=0;cards.forEach((card)=>{const show=selected==='全部'||card.dataset.category===selected;card.hidden=!show;if(show)visible+=1;});if(empty)empty.hidden=visible>0;}));
  </script>
</BaseLayout>
