---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { appointmentHrefZh } from '../../../data/catalog.zh';
import { getZhRelatedPosts, zhBlogPosts, zhBlogPublished, type ZhBlogPost } from '../../../data/blog.zh';
export function getStaticPaths(){return zhBlogPosts.map((post)=>({params:{slug:post.slug},props:{post}}));}
interface Props{post:ZhBlogPost}
const {post}=Astro.props;const relatedPosts=getZhRelatedPosts(post);const canonicalPath=`/zh/blog/${post.slug}`;const canonicalUrl=new URL(canonicalPath,Astro.site??Astro.url.origin).href;const imageUrl=new URL(post.image,Astro.site??Astro.url.origin).href;const wordCount=[post.quickAnswer,...post.sections.flatMap((section)=>section.paragraphs),...post.sections.flatMap((section)=>section.bullets??[])].join('').length;const readingMinutes=Math.max(3,Math.ceil(wordCount/500));const publishedLabel=new Intl.DateTimeFormat('zh-MY',{year:'numeric',month:'long',day:'numeric',timeZone:'Asia/Kuala_Lumpur'}).format(new Date(zhBlogPublished));
const articleSchema={'@context':'https://schema.org','@type':'BlogPosting',inLanguage:'zh-Hans-MY',headline:post.title,description:post.description,image:[imageUrl],datePublished:zhBlogPublished,dateModified:zhBlogPublished,mainEntityOfPage:canonicalUrl,author:{'@type':'Organization',name:'Sothys Kuantan 团队',url:new URL('/zh/about',Astro.site??Astro.url.origin).href},publisher:{'@type':'Organization',name:'Sothys Kuantan Premium Salon',url:new URL('/zh/',Astro.site??Astro.url.origin).href,logo:{'@type':'ImageObject',url:new URL('/brand/sothys-logo.png',Astro.site??Astro.url.origin).href}},keywords:post.keywords.join(', '),articleSection:post.category,wordCount};
const breadcrumbSchema={'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'首页',item:new URL('/zh/',Astro.site??Astro.url.origin).href},{'@type':'ListItem',position:2,name:'护肤专栏',item:new URL('/zh/blog',Astro.site??Astro.url.origin).href},{'@type':'ListItem',position:3,name:post.title,item:canonicalUrl}]};
---
<BaseLayout lang="zh" title={post.seoTitle} description={post.description} canonicalPath={canonicalPath} image={post.image} pageType="article" publishedTime={zhBlogPublished} modifiedTime={zhBlogPublished} schema={[articleSchema,breadcrumbSchema]}>
  <article class="article-page"><header class="article-header shell"><nav class="breadcrumbs" aria-label="面包屑导航"><a href="/zh/">首页</a><span aria-hidden="true">/</span><a href="/zh/blog">护肤专栏</a><span aria-hidden="true">/</span><span>{post.category}</span></nav><p class="eyebrow">{post.category} · 关丹，彭亨</p><h1>{post.title}</h1><p class="article-deck">{post.excerpt}</p><div class="article-byline"><span>Sothys Kuantan 团队撰写</span><span>发布于 {publishedLabel}</span><span>阅读约 {readingMinutes} 分钟</span></div></header>
    <figure class="article-hero shell"><img src={post.image} alt={post.imageAlt} width="1400" height="900" loading="eager" fetchpriority="high" decoding="async"/><figcaption>为 Sothys Kuantan 护肤专栏创作的原创主题图片。</figcaption></figure>
    <div class="article-layout shell"><aside class="article-summary" aria-label="快速解答"><p class="eyebrow">快速解答</p><p>{post.quickAnswer}</p><a href={appointmentHrefZh} target="_blank" rel="noopener noreferrer">咨询关丹团队</a></aside><div class="article-content">{post.sections.map((section,index)=><section><p class="article-section-number">0{index+1}</p><h2>{section.heading}</h2>{section.paragraphs.map((paragraph)=><p>{paragraph}</p>)}{section.bullets&&<ul>{section.bullets.map((bullet)=><li>{bullet}</li>)}</ul>}</section>)}<aside class="article-local-note"><p class="eyebrow">关丹本地建议</p><h2>获得适合你的专业建议。</h2><p>如需根据当前肌肤状况选择护理或 Sothys 居家产品，可预约 Sothys Kuantan 皮肤咨询。一般美容建议不能取代医疗诊断。</p><div><a class="pill" href={appointmentHrefZh} target="_blank" rel="noopener noreferrer">预约咨询</a><a class="pill-secondary" href="/zh/shop">浏览专业护理</a></div></aside>{post.sources&&post.sources.length>0&&<section class="article-sources"><p class="article-section-number">参考资料</p><h2>延伸阅读。</h2><p>以下独立资源支持本文的一般护肤建议：</p><ul>{post.sources.map((source)=><li><a href={source.href} target="_blank" rel="noopener noreferrer external">{source.label}</a></li>)}</ul></section>}<p class="article-disclaimer"><strong>编辑说明：</strong>本文提供一般美容护肤资讯，并非医疗建议。效果与适合度因人而异；若肌肤出现持续、疼痛、突然或令人担忧的变化，请咨询合格医疗专业人员。</p></div></div>
  </article>
  <section class="related-posts shell" aria-labelledby="zh-related-heading"><div class="blog-section-heading"><p class="eyebrow">继续阅读</p><h2 id="zh-related-heading">相关指南。</h2></div><div class="related-grid">{relatedPosts.map((related)=><a href={`/zh/blog/${related.slug}`}><img src={related.image} alt={related.imageAlt} width="1400" height="900" loading="lazy" decoding="async"/><p>{related.category}</p><h3>{related.title}</h3><span>阅读指南</span></a>)}</div><a class="pill-secondary related-all" href="/zh/blog">查看全部30篇指南</a></section>
</BaseLayout>
