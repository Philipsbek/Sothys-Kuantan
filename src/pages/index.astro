---
import BaseLayout from '../layouts/BaseLayout.astro';
import FacebookFeed from '../components/FacebookFeed.astro';
import MembershipPopup from '../components/MembershipPopup.astro';
import ReelsShowcase from '../components/ReelsShowcase.astro';
import ResultsShowcase from '../components/ResultsShowcase.astro';
import { appointmentHref, productCategories, productEnquiryHref, services } from '../data/catalog';

const treatmentConcernImages = [
  { src: '/treatment-hydration-dryness.webp', alt: 'Close-up of dehydrated facial skin with visible dryness and fine flaking' },
  { src: '/treatment-acne-blemishes.webp', alt: 'Close-up of blemish-prone facial skin with clogged pores and post-blemish marks' },
  { src: '/treatment-redness-sensitivity.webp', alt: 'Close-up of sensitive facial skin with visible cheek and nose redness' },
  { src: '/treatment-pigmentation-dark-spots.webp', alt: 'Close-up of facial skin with pigmentation, freckles, and uneven tone' },
  { src: '/treatment-elasticity-wrinkles.webp', alt: 'Close-up of mature facial skin with visible lines and reduced elasticity' },
  { src: '/treatment-radiance-vitality.webp', alt: 'Close-up of tired, dull-looking facial skin with reduced radiance' },
];
---

<BaseLayout title="Professional Beauty Treatments" description="Discover personalised professional facial treatments and skin consultations at Sothys Kuantan.">
  <MembershipPopup />

  <section class="hero hero-carousel" data-hero-carousel aria-label="Featured treatments and Sothys homecare">
    <div class="hero-frame">
      <div class="hero-stage">
        <article class="hero-slide hero-slide-hydration is-active" data-hero-slide aria-hidden="false">
          <div class="hero-copy">
            <div class="hero-content">
              <p class="eyebrow">01 · Hydration &amp; dryness</p>
              <h1 class="display">Deep hydration for dry, tight skin.</h1>
              <p class="lede">A comfort-focused professional facial designed to replenish dehydrated skin and restore a fresh, supple-looking finish.</p>
              <div class="hero-actions">
                <a class="pill" href={services[0].whatsappHref} target="_blank" rel="noopener noreferrer">Ask about hydration <span>↗</span></a>
                <a class="hero-text-link" href="/shop">View treatment details <span aria-hidden="true">→</span></a>
              </div>
            </div>
            <div class="hero-visual-reserve">
              <img class="hero-service-image" src="/hero-editorial-hydration-v2.webp" alt="Woman with freshly hydrated skin after professional facial care" width="1456" height="1092" loading="eager" fetchpriority="high" decoding="async" />
            </div>
          </div>
        </article>

        <article class="hero-slide hero-slide-acne" data-hero-slide aria-hidden="true">
          <div class="hero-copy">
            <div class="hero-content">
              <p class="eyebrow">02 · Acne &amp; blemishes</p>
              <h2 class="display">Targeted care for breakout-prone skin.</h2>
              <p class="lede">Professional care for breakouts, clogged pores, and visible imperfections, selected to support clearer-looking, more balanced skin.</p>
              <div class="hero-actions">
                <a class="pill" href={services[1].whatsappHref} target="_blank" rel="noopener noreferrer">Ask about acne care <span>↗</span></a>
                <a class="hero-text-link" href="/shop">View treatment details <span aria-hidden="true">→</span></a>
              </div>
            </div>
            <div class="hero-visual-reserve">
              <img class="hero-service-image" src="/hero-editorial-acne-v2.webp" alt="Professional consultation for blemish-prone skin" width="1456" height="1092" loading="lazy" decoding="async" />
            </div>
          </div>
        </article>

        <article class="hero-slide hero-slide-ageing" data-hero-slide aria-hidden="true">
          <div class="hero-copy">
            <div class="hero-content">
              <p class="eyebrow">03 · Elasticity &amp; wrinkles</p>
              <h2 class="display">Firming care for visible signs of ageing.</h2>
              <p class="lede">An age-defying treatment path focused on visible lines and loss of firmness for smoother, more refined-looking skin.</p>
              <div class="hero-actions">
                <a class="pill" href={services[4].whatsappHref} target="_blank" rel="noopener noreferrer">Ask about firming care <span>↗</span></a>
                <a class="hero-text-link" href="/shop">View treatment details <span aria-hidden="true">→</span></a>
              </div>
            </div>
            <div class="hero-visual-reserve">
              <img class="hero-service-image" src="/hero-editorial-firming-v2.webp" alt="Mature woman with luminous skin in a premium firming care portrait" width="1456" height="1092" loading="lazy" decoding="async" />
            </div>
          </div>
        </article>

        <article class="hero-slide hero-slide-homecare" data-hero-slide aria-hidden="true">
          <div class="hero-copy">
            <div class="hero-content">
              <p class="eyebrow">04 · Sothys skincare products</p>
              <h2 class="display">Professional homecare, selected for your skin.</h2>
              <p class="lede">We carry selected Sothys cleansers, serums, moisturisers, masks, sun care, and skincare sets, with recommendations available in salon.</p>
              <div class="hero-actions">
                <a class="pill" href={productEnquiryHref} target="_blank" rel="noopener noreferrer">Ask about Sothys products <span>↗</span></a>
                <a class="hero-text-link" href="#homecare">View product categories <span aria-hidden="true">→</span></a>
              </div>
            </div>
            <div class="hero-visual-reserve">
              <img class="hero-service-image hero-product-image" src="/hero-editorial-homecare-products.webp" alt="Sothys Hydra, Dermo Booster, serum, cream, and ampoule skincare collection" width="1800" height="1800" loading="lazy" decoding="async" />
            </div>
          </div>
        </article>

        <div class="hero-slider-controls" aria-label="Hero slider controls">
          <button class="hero-arrow" type="button" data-hero-prev aria-label="Show previous hero slide"><span aria-hidden="true">←</span></button>
          <div class="hero-dots" role="tablist" aria-label="Choose a hero slide">
            <button class="hero-dot is-active" type="button" data-hero-dot role="tab" aria-label="Show hydration treatment slide" aria-selected="true"></button>
            <button class="hero-dot" type="button" data-hero-dot role="tab" aria-label="Show acne treatment slide" aria-selected="false"></button>
            <button class="hero-dot" type="button" data-hero-dot role="tab" aria-label="Show firming treatment slide" aria-selected="false"></button>
            <button class="hero-dot" type="button" data-hero-dot role="tab" aria-label="Show Sothys skincare products slide" aria-selected="false"></button>
          </div>
          <button class="hero-arrow" type="button" data-hero-next aria-label="Show next hero slide"><span aria-hidden="true">→</span></button>
        </div>
      </div>

      <div class="hero-lower">
        <div class="hero-benefits" aria-label="Why choose Sothys Kuantan">
          <div class="hero-benefit">
            <span class="hero-benefit-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 3v18M3 12h18M5.6 5.6l12.8 12.8M18.4 5.6 5.6 18.4" /></svg></span>
            <div><strong>Skin-led care</strong><p>Every visit begins with your present concerns, comfort, and goals.</p></div>
          </div>
          <div class="hero-benefit">
            <span class="hero-benefit-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="7" /><circle cx="12" cy="12" r="2.5" /></svg></span>
            <div><strong>Professional expertise</strong><p>Targeted facial treatments selected around your individual skin needs.</p></div>
          </div>
          <div class="hero-benefit">
            <span class="hero-benefit-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 20s-7-4.35-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.65-7 10-7 10Z" /></svg></span>
            <div><strong>Care that continues</strong><p>Thoughtful salon and homecare guidance beyond each appointment.</p></div>
          </div>
        </div>

        <div class="hero-socials" aria-label="Connect with Sothys Kuantan">
          <span>Stay connected</span>
          <div>
            <a href="https://www.facebook.com/SothysKuantan/" target="_blank" rel="noopener noreferrer" aria-label="Follow Sothys Kuantan on Facebook">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M24 12.07C24 5.4 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.1 10.13 24v-8.44H7.08v-3.49h3.05V9.41c0-3.03 1.79-4.7 4.53-4.7 1.31 0 2.68.24 2.68.24v2.96h-1.51c-1.49 0-1.95.93-1.95 1.88v2.28h3.32l-.53 3.49h-2.79V24C19.61 23.1 24 18.1 24 12.07Z" /></svg>
            </a>
            <a href={appointmentHref} target="_blank" rel="noopener noreferrer" aria-label="Chat with Sothys Kuantan on WhatsApp">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.966-.273-.099-.471-.149-.67.149-.198.297-.768.966-.94 1.164-.173.198-.347.223-.644.074-.297-.149-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.058-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.52.149-.173.198-.297.297-.495.099-.198.05-.372-.025-.52-.074-.149-.669-1.611-.916-2.206-.242-.579-.487-.5-.669-.51-.173-.008-.372-.01-.57-.01s-.52.074-.792.372c-.273.297-1.04 1.016-1.04 2.479s1.065 2.875 1.213 3.073c.149.198 2.095 3.2 5.076 4.487.709.306 1.262.489 1.693.626.712.227 1.36.195 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347zM12.035 21.868h-.004a9.93 9.93 0 0 1-5.06-1.386l-.363-.216-3.762.987 1.004-3.667-.236-.376a9.93 9.93 0 0 1-1.523-5.315c.002-5.478 4.46-9.936 9.94-9.936a9.88 9.88 0 0 1 7.03 2.912 9.88 9.88 0 0 1 2.909 7.035c-.003 5.478-4.461 9.936-9.935 9.936zm8.455-18.39A11.88 11.88 0 0 0 12.034 0C5.446 0 .084 5.362.082 11.952a11.9 11.9 0 0 0 1.595 5.96L0 24l6.233-1.635a11.95 11.95 0 0 0 5.796 1.476h.005c6.589 0 11.951-5.362 11.954-11.952a11.88 11.88 0 0 0-3.498-8.411z" /></svg>
            </a>
            <a href="tel:+60129816966" aria-label="Call Sothys Kuantan">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7.2 3.5 4.8 5.9c-.7.7-.8 1.8-.3 2.7 2.5 4.7 6.3 8.5 11 11 .9.5 2 .4 2.7-.3l2.3-2.3-4.1-4.1-2.4 2.4a15.5 15.5 0 0 1-5.3-5.3l2.4-2.4-3.9-4.1Z" /></svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="marquee" aria-hidden="true">
    <div class="marquee-track">
      {[0, 1, 2, 3, 4].map(() => (
        <div class="marquee-group">
          <span>Personal skin consultation</span><span>Professional expertise</span><span>Targeted facial care</span><span>Visible-looking results</span><span>Relaxing salon experience</span>
        </div>
      ))}
    </div>
  </div>

  <section class="home-section shell services-intro">
    <div class="heading-block">
      <p class="eyebrow">Professional treatments</p>
      <h2 class="section-heading">Start with your skin.<br />We’ll shape the care.</h2>
      <p class="lede">Every appointment begins with your concern. Explore our treatment paths, then speak with our team for a personalised recommendation.</p>
    </div>
    <div class="service-card-grid">
      {services.slice(0, 6).map((service, index) => (
        <a class="service-card" href={service.whatsappHref} target="_blank" rel="noopener noreferrer">
          <div class="service-card-image">
            <img src={treatmentConcernImages[index].src} alt={treatmentConcernImages[index].alt} width="1200" height="900" loading="lazy" decoding="async" />
            <div class="service-card-top"><span>{service.number}</span><span aria-hidden="true">↗</span></div>
          </div>
          <div class="service-card-copy">
            <div><h3>{service.title}</h3><p>{service.description}</p></div>
            <strong>{service.outcome}</strong>
          </div>
        </a>
      ))}
    </div>
    <div class="section-action"><a class="pill-secondary" href="/shop">View all treatment paths</a></div>
  </section>

  <ResultsShowcase />

  <ReelsShowcase />

  <section class="consultation-band shell">
    <div><p class="eyebrow">Not sure where to begin?</p><h2>Your best treatment starts with a conversation.</h2></div>
    <div>
      <p>Tell us what your skin is experiencing. Our team will help you choose the most suitable treatment path and appointment.</p>
      <a class="pill" href={appointmentHref} target="_blank" rel="noopener noreferrer">Ask on WhatsApp <span>↗</span></a>
    </div>
  </section>

  <section class="home-section shell product-enquiry-section" id="homecare">
    <div class="product-enquiry-copy">
      <p class="eyebrow">Professional homecare</p>
      <h2 class="section-heading">Support your results<br />between visits.</h2>
      <p class="lede">We also carry selected Sothys homecare categories in salon. For recommendations, availability, and pricing, contact our team on WhatsApp.</p>
      <a class="pill" href={productEnquiryHref} target="_blank" rel="noopener noreferrer">Ask about homecare <span>↗</span></a>
    </div>
    <div class="product-category-list" aria-label="Available homecare categories">
      {productCategories.map((category, index) => <div><span>{String(index + 1).padStart(2, '0')}</span><p>{category}</p></div>)}
    </div>
  </section>

  <section class="home-section shell" style="padding-top: 0;">
    <div class="principles">
      <div><p class="eyebrow">The Sothys approach</p><h2>Expert hands.<br />Personal care.</h2></div>
      <div class="principle-list">
        <div class="principle"><span>01</span><p>A conversation focused on your skin concerns and treatment goals.</p></div>
        <div class="principle"><span>02</span><p>A professional treatment path selected for your individual needs.</p></div>
        <div class="principle"><span>03</span><p>French institute expertise delivered in a calm salon setting.</p></div>
        <div class="principle"><span>04</span><p>Thoughtful homecare guidance to support your salon results.</p></div>
      </div>
    </div>
  </section>

  <FacebookFeed />

  <script>
    const carousel = document.querySelector<HTMLElement>('[data-hero-carousel]');
    const slides = Array.from(carousel?.querySelectorAll<HTMLElement>('[data-hero-slide]') ?? []);
    const dots = Array.from(carousel?.querySelectorAll<HTMLButtonElement>('[data-hero-dot]') ?? []);
    const previous = carousel?.querySelector<HTMLButtonElement>('[data-hero-prev]');
    const next = carousel?.querySelector<HTMLButtonElement>('[data-hero-next]');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let activeSlide = 0;
    let timer: number | undefined;

    const showSlide = (index: number) => {
      activeSlide = (index + slides.length) % slides.length;
      slides.forEach((slide, slideIndex) => {
        const isActive = slideIndex === activeSlide;
        slide.classList.toggle('is-active', isActive);
        slide.setAttribute('aria-hidden', String(!isActive));
        slide.querySelectorAll<HTMLElement>('a, button').forEach((control) => {
          control.tabIndex = isActive ? 0 : -1;
        });
      });
      dots.forEach((dot, dotIndex) => {
        const isActive = dotIndex === activeSlide;
        dot.classList.toggle('is-active', isActive);
        dot.setAttribute('aria-selected', String(isActive));
      });
    };

    const stopAutoplay = () => {
      if (timer !== undefined) window.clearInterval(timer);
      timer = undefined;
    };

    const startAutoplay = () => {
      stopAutoplay();
      if (!reduceMotion.matches && slides.length > 1) {
        timer = window.setInterval(() => showSlide(activeSlide + 1), 6500);
      }
    };

    previous?.addEventListener('click', () => {
      showSlide(activeSlide - 1);
      startAutoplay();
    });
    next?.addEventListener('click', () => {
      showSlide(activeSlide + 1);
      startAutoplay();
    });
    dots.forEach((dot, index) => dot.addEventListener('click', () => {
      showSlide(index);
      startAutoplay();
    }));

    carousel?.addEventListener('mouseenter', stopAutoplay);
    carousel?.addEventListener('mouseleave', startAutoplay);
    carousel?.addEventListener('focusin', stopAutoplay);
    carousel?.addEventListener('focusout', (event) => {
      const nextFocus = event.relatedTarget;
      if (!(nextFocus instanceof Node) || !carousel.contains(nextFocus)) startAutoplay();
    });
    carousel?.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') showSlide(activeSlide - 1);
      if (event.key === 'ArrowRight') showSlide(activeSlide + 1);
    });
    document.addEventListener('visibilitychange', () => document.hidden ? stopAutoplay() : startAutoplay());
    reduceMotion.addEventListener('change', startAutoplay);

    showSlide(0);
    startAutoplay();
  </script>
</BaseLayout>
