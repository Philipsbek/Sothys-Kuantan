---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { products, type Product } from '../../data/catalog';

export function getStaticPaths() {
  return products.map((product) => ({ params: { slug: product.handle }, props: { product } }));
}

interface Props { product: Product; }
const { product } = Astro.props;
const related = products.filter((item) => item.category === product.category && item.handle !== product.handle).slice(0, 3);
const metaPairs = product.meta
  ? product.meta.split(/(?=Skin type:|Texture:|Scents:|Size:)/i).map((item) => item.trim()).filter(Boolean).map((item) => {
      const split = item.indexOf(':');
      return [item.slice(0, split), item.slice(split + 1).trim()];
    })
  : [['Collection', product.category], ['Origin', 'Made in France']];
---

<BaseLayout title={product.title} description={product.description}>
  <section class="product-detail shell">
    <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>›</span><a href="/shop">Shop</a><span>›</span><span>{product.title}</span></nav>
    <div class="product-detail-grid">
      <div class="detail-visual">
        {product.image ? <img src={product.image} alt={product.title} /> : <span class="product-placeholder">SOTHYS</span>}
      </div>
      <div class="detail-copy">
        <p class="eyebrow">{product.category}</p>
        <h1>{product.title}</h1>
        <p class="detail-price">{product.price}</p>
        <p class="detail-description">{product.description}</p>
        <div class="meta-stack">
          {metaPairs.map(([label, value]) => <div class="meta-row"><span>{label}</span><span>{value}</span></div>)}
        </div>
        <div class="detail-actions">
          <a class="pill" href={`/contact?product=${encodeURIComponent(product.title)}`}>Ask about this product ↗</a>
          <a class="pill-secondary" href="/shop">Back to shop</a>
        </div>
      </div>
    </div>
  </section>

  {related.length > 0 && <section class="home-section shell" style="padding-top: 20px;">
    <div class="heading-block"><p class="eyebrow">Keep exploring</p><h2 class="section-heading">More in {product.category}.</h2></div>
    <div class="featured-grid">{related.map((item, index) => <ProductCard product={item} index={index} />)}</div>
  </section>}
</BaseLayout>
