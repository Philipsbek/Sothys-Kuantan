---
import BaseLayout from '../layouts/BaseLayout.astro';
import { appointmentHref, productCategories, productEnquiryHref, services } from '../data/catalog';
---

<BaseLayout title="Professional Treatments" description="Explore personalised professional facial treatment paths at Sothys Kuantan and book a consultation on WhatsApp.">
  <section class="page-hero services-hero shell">
    <p class="eyebrow">Professional beauty treatments</p>
    <h1 class="display display-sm">Treatments shaped<br />around your skin.</h1>
    <div class="intro-grid">
      <p class="eyebrow">Personalised care</p>
      <div>
        <p>Choose the concern closest to your skin today. Our team will listen, guide you, and help select the right professional treatment path.</p>
        <a class="pill" href={appointmentHref} target="_blank" rel="noopener noreferrer">Book a consultation <span>↗</span></a>
      </div>
    </div>
  </section>

  <section class="services-directory shell">
    <div class="service-list">
      {services.map((service) => (
        <article class="service-row-expanded">
          <span class="number">{service.number}</span>
          <div class="service-name"><p class="eyebrow">Treatment path</p><h2>{service.title}</h2></div>
          <div class="service-copy"><p>{service.description}</p><strong>{service.outcome}</strong></div>
          <a href={service.whatsappHref} target="_blank" rel="noopener noreferrer" aria-label={`Ask about ${service.title}`}>Ask about this treatment <span>↗</span></a>
        </article>
      ))}
    </div>
  </section>

  <section class="consultation-band shell">
    <div><p class="eyebrow">Your first step</p><h2>Let’s understand your skin.</h2></div>
    <div>
      <p>You do not need to know which treatment to choose. Share your concern with us and we’ll help you begin.</p>
      <a class="pill" href={appointmentHref} target="_blank" rel="noopener noreferrer">Message our team <span>↗</span></a>
    </div>
  </section>

  <section class="home-section shell product-enquiry-section">
    <div class="product-enquiry-copy">
      <p class="eyebrow">Homecare, by consultation</p>
      <h2 class="section-heading">Selected support<br />for your routine.</h2>
      <p class="lede">Our salon carries selected homecare categories. We do not list individual products online; contact us for a recommendation, availability, and pricing.</p>
      <a class="pill-secondary" href={productEnquiryHref} target="_blank" rel="noopener noreferrer">Ask on WhatsApp <span>↗</span></a>
    </div>
    <div class="product-category-list" aria-label="Available homecare categories">
      {productCategories.map((category, index) => <div><span>{String(index + 1).padStart(2, '0')}</span><p>{category}</p></div>)}
    </div>
  </section>
</BaseLayout>
