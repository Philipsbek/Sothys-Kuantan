---
interface Props { lang?: 'en' | 'zh' }
const { lang = 'en' } = Astro.props;
const isZh = lang === 'zh';
const facebookPageUrl = 'https://www.facebook.com/SothysKuantan/';
const copy = isZh ? {
  eyebrow: '保持联系', headingA: '掌握美容院', headingB: '最新动态。', intro: '关注 Sothys Kuantan Facebook，了解美容院消息、近期活动、护理亮点、护肤建议与最新资讯。', follow: '关注我们的 Facebook', profileAria: '前往 Sothys Kuantan Premium Salon Facebook 页面', label: 'Facebook', footer: '消息 · 活动 · 护肤', visit: '浏览页面',
} : {
  eyebrow: 'Stay connected', headingA: 'The latest from', headingB: 'our salon.', intro: 'Follow Sothys Kuantan on Facebook for salon news, upcoming events, treatment highlights, skincare guidance, and our latest updates.', follow: 'Follow us on Facebook', profileAria: 'Visit Sothys Kuantan Premium Salon on Facebook', label: 'Facebook', footer: 'News · Events · Skincare', visit: 'Visit page',
};
---

<section class="facebook-section home-section shell" aria-labelledby="facebook-heading">
  <div class="facebook-panel">
    <div class="facebook-copy">
      <div>
        <p class="eyebrow">{copy.eyebrow}</p>
        <h2 id="facebook-heading">{copy.headingA}<br />{copy.headingB}</h2>
        <p>{copy.intro}</p>
      </div>
      <a class="pill" href={facebookPageUrl} target="_blank" rel="noopener noreferrer">
        {copy.follow} <span aria-hidden="true">↗</span>
      </a>
    </div>

    <a
      class="facebook-profile-card"
      href={facebookPageUrl}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={copy.profileAria}
    >
      <div class="facebook-mark" aria-hidden="true">
        <svg viewBox="0 0 24 24" role="img">
          <path d="M24 12.07C24 5.4 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.1 10.13 24v-8.44H7.08v-3.49h3.05V9.41c0-3.03 1.79-4.7 4.53-4.7 1.31 0 2.68.24 2.68.24v2.96h-1.51c-1.49 0-1.95.93-1.95 1.88v2.28h3.32l-.53 3.49h-2.79V24C19.61 23.1 24 18.1 24 12.07Z" />
        </svg>
      </div>
      <div class="facebook-profile-copy">
        <p class="facebook-profile-label">{copy.label}</p>
        <h3>Sothys Kuantan<br />Premium Salon</h3>
        <p>@SothysKuantan</p>
      </div>
      <div class="facebook-profile-footer">
        <span>{copy.footer}</span>
        <strong>{copy.visit} <span aria-hidden="true">↗</span></strong>
      </div>
    </a>
  </div>
</section>
