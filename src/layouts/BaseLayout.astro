---
import '../styles/global.css';

interface Props {
  title: string;
  lang?: 'en' | 'zh';
  description?: string;
  canonicalPath?: string;
  image?: string;
  pageType?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  lang = 'en',
  description: descriptionProp,
  canonicalPath,
  image = '/hero-sothys-products.webp',
  pageType = 'website',
  publishedTime,
  modifiedTime,
  schema = [],
} = Astro.props;

const path = Astro.url.pathname;
const isChinese = lang === 'zh';
const description = descriptionProp ?? (isChinese
  ? 'Sothys Kuantan 提供个性化专业面部护理、皮肤咨询与 Sothys 居家护肤建议。'
  : 'Personalised professional facial treatments and skin consultations at Sothys Kuantan.');
const englishPath = path.startsWith('/zh') ? path.slice(3) || '/' : path;
const chinesePath = path.startsWith('/zh') ? path : `/zh${path === '/' ? '' : path}`;
const englishUrl = new URL(englishPath, Astro.site ?? Astro.url.origin);
const chineseUrl = new URL(chinesePath, Astro.site ?? Astro.url.origin);
const canonicalUrl = new URL(canonicalPath ?? path, Astro.site ?? Astro.url.origin);
const socialImage = new URL(image, Astro.site ?? Astro.url.origin);
const routePrefix = isChinese ? '/zh' : '';
const labels = isChinese
  ? { home: '首页', about: '关于我们', services: '专业护理', blog: '护肤专栏', terms: '条款', contact: '联系我们' }
  : { home: 'Home', about: 'About', services: 'Services', blog: 'Blog', terms: 'Terms', contact: 'Contact' };
const links = [
  { href: `${routePrefix}/` || '/', label: labels.home },
  { href: `${routePrefix}/about`, label: labels.about },
  { href: `${routePrefix}/shop`, label: labels.services },
  { href: `${routePrefix}/blog`, label: labels.blog },
  { href: `${routePrefix}/terms-and-conditions`, label: labels.terms },
  { href: `${routePrefix}/contact`, label: labels.contact },
];
const isActive = (href: string) => {
  if (href === '/') return path === '/';
  if (href === '/zh/') return path === '/zh' || path === '/zh/';
  return path.startsWith(href);
};
const whatsappMessage = isChinese
  ? '您好！我想了解 Sothys Kuantan 的专业护理疗程。'
  : "Hi! I'm interested in your treatments at Sothys Kuantan. I would like to know more!";
const whatsappHref = `https://wa.me/60129816966?text=${encodeURIComponent(whatsappMessage)}`;
const appointmentMessage = isChinese
  ? '您好！我想预约 Sothys Kuantan 的护理疗程。'
  : "Hi! I'd like to book an appointment at Sothys Kuantan.";
const appointmentHref = `https://wa.me/60129816966?text=${encodeURIComponent(appointmentMessage)}`;
const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': ['BeautySalon', 'DaySpa'],
  name: 'Sothys Kuantan Premium Salon',
  url: new URL('/', Astro.site ?? Astro.url.origin).href,
  image: socialImage.href,
  telephone: '+60 12-981 6966',
  email: 'ivonliew@gmail.com',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '43, Jalan Putra Square 3, China Town',
    addressLocality: 'Kuantan',
    addressRegion: 'Pahang',
    postalCode: '25200',
    addressCountry: 'MY',
  },
  sameAs: ['https://www.facebook.com/SothysKuantan/'],
  openingHoursSpecification: [
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday', 'Friday'], opens: '10:00', closes: '19:00' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Saturday', 'Sunday'], opens: '10:00', closes: '18:00' },
  ],
  areaServed: { '@type': 'City', name: 'Kuantan' },
};
const pageSchemas = Array.isArray(schema) ? schema : [schema];
---

<!doctype html>
<html lang={isChinese ? 'zh-Hans' : 'en'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl.href} />
    <link rel="alternate" hreflang="en-MY" href={englishUrl.href} />
    <link rel="alternate" hreflang="zh-Hans-MY" href={chineseUrl.href} />
    <link rel="alternate" hreflang="x-default" href={englishUrl.href} />
    <meta property="og:type" content={pageType} />
    <meta property="og:title" content={`${title} · Sothys Kuantan`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl.href} />
    <meta property="og:image" content={socialImage.href} />
    <meta property="og:locale" content={isChinese ? 'zh_MY' : 'en_MY'} />
    <meta property="og:locale:alternate" content={isChinese ? 'en_MY' : 'zh_MY'} />
    <meta property="og:site_name" content="Sothys Kuantan" />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} · Sothys Kuantan`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage.href} />
    <link rel="icon" type="image/png" href="/brand/sothys-favicon.png" />
    <title>{title} · Sothys Kuantan</title>
    <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
    {pageSchemas.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} />)}
  </head>
  <body class:list={{ 'home-page': path === '/' || path === '/zh' || path === '/zh/' }}>
    <header class="site-header">
      <a class="brand" href={isChinese ? '/zh/' : '/'} aria-label={isChinese ? 'Sothys Kuantan 首页' : 'Sothys Kuantan home'}>
        <img src="/brand/sothys-logo.png" alt="Sothys Kuantan" />
      </a>
      <nav class="desktop-nav" aria-label={isChinese ? '主要导航' : 'Primary navigation'}>
        {links.map((link) => (
          <a class:list={{ active: isActive(link.href) }} href={link.href}>{link.label}</a>
        ))}
      </nav>
      <div class="header-actions">
        <a class="language-switcher" href={isChinese ? englishPath : chinesePath} lang={isChinese ? 'en' : 'zh-Hans'}>{isChinese ? 'EN' : '中文'}</a>
        <a class="header-booking" href={appointmentHref} target="_blank" rel="noopener noreferrer">{isChinese ? '预约护理' : 'Book appointment'}</a>
      </div>
      <button class="menu-toggle" aria-expanded="false" aria-controls="mobile-menu">
        <span>{isChinese ? '菜单' : 'Menu'}</span><span class="menu-mark">+</span>
      </button>
      <div class="mobile-menu" id="mobile-menu" hidden>
        {links.map((link, index) => (
          <a class:list={{ active: isActive(link.href) }} href={link.href}>
            <span>0{index + 1}</span>{link.label}
          </a>
        ))}
        <div class="mobile-language" aria-label={isChinese ? '切换语言' : 'Switch language'}>
          <span>{isChinese ? '语言' : 'Language'}</span>
          <a href={isChinese ? englishPath : chinesePath} lang={isChinese ? 'en' : 'zh-Hans'}>{isChinese ? 'English' : '简体中文'}</a>
        </div>
        <a class="mobile-booking" href={appointmentHref} target="_blank" rel="noopener noreferrer">{isChinese ? '预约护理' : 'Book appointment'} <span>↗</span></a>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer shell">
      <div class="footer-lead">
        <p class="eyebrow">Sothys Kuantan</p>
        <h2>{isChinese ? <>每个人的肌肤都不同。<br />护理也应该量身定制。</> : <>Your skin is personal.<br />Your treatment should be too.</>}</h2>
      </div>
      <div class="footer-grid">
        <div>
          <p class="footer-label">{isChinese ? '地址' : 'Visit'}</p>
          <p>43, Jalan Putra Square 3, China Town<br />25200 Kuantan, Pahang</p>
        </div>
        <div>
          <p class="footer-label">{isChinese ? '联系方式' : 'Contact'}</p>
          <a href="mailto:ivonliew@gmail.com">ivonliew@gmail.com</a>
          <a href="tel:+60129816966">012-981 6966</a>
          <a href="tel:+6095173699">09-517 3699</a>
        </div>
        <div>
          <p class="footer-label">{isChinese ? '浏览网站' : 'Explore'}</p>
          {links.slice(1).map((link) => <a href={link.href}>{link.label}</a>)}
        </div>
      </div>
      <div class="footer-bottom">
        <span>© 2026 Sothys Kuantan</span>
        <span>{isChinese ? '专业美容护理' : 'Professional beauty treatments'}</span>
      </div>
      <p class="footer-credit">Powered by <a href="https://ashetag.com" target="_blank" rel="noopener noreferrer">Ashetag</a></p>
    </footer>
    <a class="floating-action" href={whatsappHref} target="_blank" rel="noopener noreferrer" aria-label={isChinese ? '通过 WhatsApp 联系 Sothys' : 'Chat with Sothys on WhatsApp'} title={isChinese ? 'WhatsApp 咨询' : 'Chat on WhatsApp'}>
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.966-.273-.099-.471-.149-.67.149-.198.297-.768.966-.94 1.164-.173.198-.347.223-.644.074-.297-.149-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.058-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.52.149-.173.198-.297.297-.495.099-.198.05-.372-.025-.52-.074-.149-.669-1.611-.916-2.206-.242-.579-.487-.5-.669-.51-.173-.008-.372-.01-.57-.01s-.52.074-.792.372c-.273.297-1.04 1.016-1.04 2.479s1.065 2.875 1.213 3.073c.149.198 2.095 3.2 5.076 4.487.709.306 1.262.489 1.693.626.712.227 1.36.195 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347zM12.035 21.868h-.004a9.93 9.93 0 0 1-5.06-1.386l-.363-.216-3.762.987 1.004-3.667-.236-.376a9.93 9.93 0 0 1-1.523-5.315c.002-5.478 4.46-9.936 9.94-9.936a9.88 9.88 0 0 1 7.03 2.912 9.88 9.88 0 0 1 2.909 7.035c-.003 5.478-4.461 9.936-9.935 9.936zm8.455-18.39A11.88 11.88 0 0 0 12.034 0C5.446 0 .084 5.362.082 11.952a11.9 11.9 0 0 0 1.595 5.96L0 24l6.233-1.635a11.95 11.95 0 0 0 5.796 1.476h.005c6.589 0 11.951-5.362 11.954-11.952a11.88 11.88 0 0 0-3.498-8.411z" />
      </svg>
    </a>
    <script>
      const header = document.querySelector<HTMLElement>('.site-header');
      const button = document.querySelector<HTMLButtonElement>('.menu-toggle');
      const menu = document.querySelector<HTMLElement>('#mobile-menu');

      const updateHeader = () => {
        header?.classList.toggle('is-scrolled', window.scrollY > 24);
      };

      updateHeader();
      window.addEventListener('scroll', updateHeader, { passive: true });

      button?.addEventListener('click', () => {
        const open = button.getAttribute('aria-expanded') === 'true';
        button.setAttribute('aria-expanded', String(!open));
        if (menu) menu.hidden = open;
        header?.classList.toggle('menu-open', !open);
        const mark = button.querySelector('.menu-mark');
        if (mark) mark.textContent = open ? '+' : '×';
      });
    </script>
  </body>
</html>
